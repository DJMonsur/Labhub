# ──────────────────────────────────────────────────────────────────────────
# PSHS-CARC LIMS — Environment Variables Template
#
# Copy this file to ".env" (same folder as manage.py) and fill in your own
# values. ".env" is gitignored — never commit your real credentials.
# ──────────────────────────────────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ── DATABASE ──────────────────────────────────────────────────────────────
# sqlite = no setup needed, database lives in db.sqlite3   (default)
# mysql  = the original setup; import biology_lab_lims.sql first
# DATABASE_URL = serverless PostgreSQL (production / Vercel). When this is
#                set it wins over DB_ENGINE. The Vercel + Neon integration
#                injects it automatically, e.g.
#                postgresql://user:pass@host/db?sslmode=require
DB_ENGINE=sqlite

# Only used when DB_ENGINE=mysql
DB_NAME=lims_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS (leave True for local development)
CORS_ALLOW_ALL_ORIGINS=True

# ──────────────────────────────────────────────────────────────────────────
# PRODUCTION ONLY — leave these commented out for local development
# ──────────────────────────────────────────────────────────────────────────
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=labhub.example.com,www.labhub.example.com
# CSRF_TRUSTED_ORIGINS=https://labhub.example.com,https://www.labhub.example.com
# CORS_ALLOW_ALL_ORIGINS=False
# SECURE_HSTS_SECONDS=31536000

# ──────────────────────────────────────────────────────────────────────────
# VERCEL DEPLOYMENT — set these (without the #) in your Vercel project's
# Environment Variables, then push to GitHub and it deploys itself.
#   DJANGO_SECRET_KEY     generate once, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
#   DJANGO_DEBUG          False
#   DJANGO_ALLOWED_HOSTS  your-project-name.vercel.app,your-real-domain.com
#   CSRF_TRUSTED_ORIGINS  https://your-project-name.vercel.app,https://your-real-domain.com
#   CORS_ALLOW_ALL_ORIGINS=False
#   DATABASE_URL          the Neon (or other Postgres) connection string.
#                         Install Neon's Vercel integration and it is injected
#                         automatically — no need to copy it by hand.
#   SEED_DEMO_ACCOUNTS    true if you want the demo logins created live
#                         (default: demo accounts are production-blocked)
# ──────────────────────────────────────────────────────────────────────────

# ── GOOGLE SIGN-IN (optional) ─────────────────────────────────────────────
# Leave these blank to use username/password login instead. Fill them in and
# the "Continue with Google" button appears on the sign-in page automatically.
# Get them from console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict Google sign-in to one email domain. Blank = allow any account.
ALLOWED_EMAIL_DOMAIN=carc.pshs.edu.ph
